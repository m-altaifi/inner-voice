# Copy to .env on first setup. Preserve existing credentials; never commit them.
# Start offline; CLI flags override these settings.
IV_PROVIDER=none

# anthropic -> ANTHROPIC_API_KEY; default model in src/provider.rs
# openai -> OPENAI_API_KEY; IV_MODEL required
# gemini -> GEMINI_API_KEY; IV_MODEL required
# openrouter -> OPENROUTER_API_KEY; IV_MODEL required
# deepseek -> DEEPSEEK_API_KEY; defaults to deepseek-chat
# Choose a model available to your account.
# IV_MODEL=your-model-id
#
# OpenRouter is the testing lane, not a production default -- override it on the
# command line (--provider openrouter --model <id>) rather than editing this file.
# Measured 2026-09-06, same model both ways, `--setup` and the live coach test:
# openrouter/google/gemini-3.5-flash-lite is ~1.0 s on the first turn and
# 557-943 ms after; gemini direct is the same warm but ~4 s cold. Pick a
# non-reasoning model for the fast lane -- gpt-oss-120b and qwen3.7-flash spend
# the whole budget thinking and `--setup` reports "provider returned no advice".
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=

# Paths relative to the directory from which you launch the app.
# IV_WHISPER=models/ggml-large-v3-turbo-q5_0.bin
# IV_PROMPT=prompt.md
# Research persona for /research. A missing file falls back to the built-in prompt.
# IV_RESEARCH_PROMPT=research.md
# IV_KNOWLEDGE=knowledge
# Folder of reference files that persist across sessions; dropped files from
# elsewhere are remembered by path in <folder>/.dropped.
# IV_REFERENCES=references
# IV_VOICES=models/campplus_sv_en_voxceleb_16k.onnx
# Voices you have named, remembered between calls: a speaker embedding and a
# name per person, so the next call recognises them on their first word.
# `/who <name>` names whoever just spoke. Set it empty to turn the memory off
# and keep names within a single call. Holds voice data; git-ignored.
# IV_PEOPLE=people.json
# Device names from --list-devices; loopback must match call playback.
# IV_MIC=Microphone name
# IV_LOOPBACK=Headphones name
# Hear only one app as THEM (any part of its name; --list-apps shows them).
# Watch a video during a call without it being transcribed as the far end.
# A comma list hears several apps at once, each on its own stream. Names are
# matched as substrings when a stream opens, so an app that is not running yet
# is registered and waited for. Unset means THEM is the whole speaker mix.
# `/hear` in the question box (Ctrl+Shift+F2) changes it mid-run; this is the
# durable default.
# IV_HEAR=discord,chrome
# Listen and log all day without advising: advice comes only from a typed
# question and /research, and Ctrl+Shift+F3 arms it for the session. Not the
# same as Pause, which stops transcription outright.
# IV_MANUAL=true
# Which voice reads advice aloud. Any part of a name; --setup lists them.
# Unset takes the first OneCore voice -- still better than the SAPI default,
# which is one of the three ancient "Desktop" voices.
# IV_VOICE=Mark
# IV_MIC_GATE=0.02
# IV_SYS_GATE=0.02
# IV_MIN_WORDS=3
# How long (ms) the far end must stop talking before advice is worth paying
# for. The VAD ends a turn after 500 ms of quiet, so one spoken question
# arrives as several turns -- a real 45-second interview question came in as
# eight, and asking on each bought eight requests for one answer. Waiting
# costs latency on the turn that matters and nothing else: advice about a
# fragment of a question still being asked cannot be acted on anyway. 0 asks
# on every finished turn, which is what this did before.
# IV_SETTLE=800
# IV_ALPHA=240
# Read advice aloud. With IV_HEAR the voice is never captured; without it the
# call is deafened while the voice talks.
IV_SPEAK=true

# Empty IV_LOG disables private transcript logging. Audio dumps default off.
# IV_LOG=logs
# IV_DUMP=clips

# Optional: route /research through Claude Code instead of the provider.
# Leave unset for provider research (including Gemini); no CLI is required.
# IV_AGENT_CMD=C:\Users\<you>\AppData\Roaming\npm\node_modules\@anthropic-ai\claude-code\bin\claude.exe
# IV_AGENT_ROOT=.
# IV_AGENT_TIMEOUT=90
# Optional literal filename search included in manually triggered research.
# IV_SEARCH_QUERY=migration
# IV_ES=es.exe
