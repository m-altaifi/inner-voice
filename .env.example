# Copy to .env on first setup. Preserve existing credentials; never commit them.
# Start offline; CLI flags override these settings.
IV_PROVIDER=none

# anthropic -> ANTHROPIC_API_KEY; default model in src/provider.rs
# openai -> OPENAI_API_KEY; IV_MODEL required
# gemini -> GEMINI_API_KEY; IV_MODEL required
# openrouter -> OPENROUTER_API_KEY; IV_MODEL required
# deepseek -> DEEPSEEK_API_KEY; defaults to deepseek-chat
# Choose a model available to your account.
# IV_MODEL=your-model-id
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=

# Paths relative to the directory from which you launch the app.
# IV_WHISPER=models/ggml-large-v3-turbo-q5_0.bin
# IV_PROMPT=prompt.md
# Research persona for F8. A missing file falls back to the built-in prompt.
# IV_RESEARCH_PROMPT=research.md
# IV_KNOWLEDGE=knowledge
# IV_VOICES=models/campplus_sv_en_voxceleb_16k.onnx
# Device names from --list-devices; loopback must match call playback.
# IV_MIC=Microphone name
# IV_LOOPBACK=Headphones name
# Hear only one app as THEM (any part of its name; --list-apps shows them).
# Watch a video during a call without it being transcribed as the far end.
# Unset means THEM is the whole speaker mix.
# IV_HEAR=discord
# IV_MIC_GATE=0.02
# IV_SYS_GATE=0.02
# IV_MIN_WORDS=3
# IV_ALPHA=240
# Read advice aloud. With IV_HEAR the voice is never captured; without it the
# call is deafened while the voice talks.
IV_SPEAK=1

# Empty IV_LOG disables private transcript logging. Audio dumps default off.
# IV_LOG=logs
# IV_DUMP=clips

# F8 research runs over the coaching provider; a CLI is optional. Setting
# IV_AGENT_CMD routes it through an authenticated Codex instead — actual .exe
# path, read-only sandbox, no automatic approvals, 1 MB output limit.
# IV_AGENT_CMD=C:\path\to\codex.exe
# IV_AGENT_ROOT=knowledge
# IV_AGENT_TIMEOUT=90
# Optional literal filename search included in manually triggered research.
# IV_SEARCH_QUERY=migration
# IV_ES=es.exe
